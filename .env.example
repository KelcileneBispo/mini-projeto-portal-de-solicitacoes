# Valores locais de desenvolvimento. Copie este arquivo para .env.
# Não use estas credenciais fora da máquina local.

POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal_solicitacoes
POSTGRES_PORT=5432

DATABASE_URL=postgresql://portal:portal@localhost:5432/portal_solicitacoes?schema=public

# Obrigatórias para a API iniciar. Não coloque um segredo real neste arquivo.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origem do frontend, prevista para quando o navegador passar a chamar a API.
CORS_ORIGIN=http://localhost:3000

# URL da API lida pelo frontend. Os componentes não devem fixar este endereço.
NEXT_PUBLIC_API_URL=http://localhost:3001
