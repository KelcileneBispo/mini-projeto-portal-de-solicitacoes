{
  "name": "@portal/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "predev": "pnpm --filter @portal/types build",
    "build": "nest build",
    "prebuild": "pnpm --filter @portal/types build && prisma generate",
    "start": "node dist/src/main.js",
    "lint": "eslint .",
    "test": "node --import tsx --test src/**/*.test.ts",
